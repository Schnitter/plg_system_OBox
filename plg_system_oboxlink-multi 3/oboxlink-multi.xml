<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" version="5.0" group="system" method="upgrade">
    <name>System - Obox Link Multi</name>
    <author>Mark Lehmbach</author>
    <version>1.4.0</version>
    <description>Fügt mehrere benutzerdefinierte Links als Boxen im Admin-Dashboard hinzu (grafisches Formular)</description>

    <config>
        <fields name="params">
            <fieldset name="basic">
                <field name="links" type="subform" label="Links" description="Füge beliebig viele Links hinzu.">
                    <form>
                        <fields name="params">
                            <field name="url" type="url" label="URL" description="Link-Adresse" />
                            <field name="text" type="text" label="Text" description="Angezeigter Text" />
                            <field name="icon" type="text" label="Icon (FontAwesome)" description="z.B. fa-solid fa-link" default="fa-solid fa-link" />
                        </fields>
                    </form>
                </field>
            </fieldset>
        </fields>
    </config>

    <files>
        <filename plugin="oboxlink-multi">oboxlink-multi.php</filename>
    </files>
</extension>
